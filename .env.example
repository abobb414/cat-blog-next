# Cloudflare 资源配置 —— 复制本文件为 .env.local 并填入真实值
# D1 / R2 的 ID 可在 Cloudflare Dashboard 或 wrangler.toml 中找到

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_api_token_with_d1_and_r2_permissions
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_R2_BUCKET=duoduo-photos
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
